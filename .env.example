# Contrail configuration (12-factor). Copy to .env and adjust.
# LOCAL DEVELOPMENT ONLY: none of the values below are safe for production.
# For a real deployment set APP_ENV=production, which refuses to start on the
# default API_PASSWORD or a missing/short JWT_SECRET.
# Values below are the in-compose defaults; override host-side with
# KAFKA_BOOTSTRAP=localhost:9092 etc. when running outside Docker.

KAFKA_BOOTSTRAP=redpanda:29092
KAFKA_RAW_TOPIC=flight.events.raw
KAFKA_PARTITIONS=6
KAFKA_CONSUMER_GROUP=contrail-sink

POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=contrail
POSTGRES_USER=contrail
POSTGRES_PASSWORD=contrail

# Data source: synthetic | opensky
SOURCE=synthetic
OPENSKY_POLL_INTERVAL_S=15
OPENSKY_BBOX=45,5,55,15

# Synthetic generator + chaos knobs (Phase 1 sweeps these).
GEN_AIRCRAFT=50
GEN_RATE_HZ=1.0
GEN_SEED=1337
CHAOS_OUT_OF_ORDER_PROB=0.0
CHAOS_MAX_SKEW_S=5.0
CHAOS_DUPLICATE_PROB=0.0
CHAOS_LATE_PROB=0.0
CHAOS_LATE_DELAY_S=90.0
CHAOS_DROP_PROB=0.0

# Optional: drop raw events older than this many days. Unset = keep forever.
# RETENTION_DAYS=30

# Compose port exposure. Ports for the broker, databases and dashboards bind to
# loopback unless you change this; the API port is separate.
# BIND_HOST=127.0.0.1
# API_BIND_HOST=0.0.0.0
# TIMESCALE_HOST_PORT=5432   # host port for TimescaleDB, if a local PostgreSQL already uses 5432
# GRAFANA_ANONYMOUS=true
# GRAFANA_ADMIN_PASSWORD=admin

# Windowing
WINDOW_S=60
ALLOWED_LATENESS_S=30.0

REDIS_URL=redis://redis:6379/0

# Auth. Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# With the placeholder left in place the API signs with a random per-process key,
# so tokens stop working on every restart. JWT_TTL_S is the token lifetime.
APP_ENV=development
JWT_SECRET=dev-only-change-me
JWT_TTL_S=3600
API_USER=operator
API_PASSWORD=contrail
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
LOGIN_RATE_LIMIT_RPS=0.5
LOGIN_RATE_LIMIT_BURST=10
# Limits are per API process (not shared between replicas). Idle buckets expire and
# the bucket count is capped so spoofed client addresses cannot grow memory.
RATE_LIMIT_IDLE_TTL_S=600
RATE_LIMIT_MAX_BUCKETS=10000
# Number of reverse proxies in front of the API that append to X-Forwarded-For.
# 0 (default) ignores the header entirely; never set it unless a proxy really is there.
TRUSTED_PROXY_HOPS=0

LOG_LEVEL=INFO
