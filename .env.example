# Contrail configuration (12-factor). Copy to .env and adjust.
# Values below are the in-compose defaults; override host-side with
# KAFKA_BOOTSTRAP=localhost:9092 etc. when running outside Docker.

KAFKA_BOOTSTRAP=redpanda:29092
KAFKA_RAW_TOPIC=flight.events.raw
KAFKA_PARTITIONS=6
KAFKA_CONSUMER_GROUP=contrail-sink

POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
POSTGRES_DB=contrail
POSTGRES_USER=contrail
POSTGRES_PASSWORD=contrail

# Data source: synthetic | opensky
SOURCE=synthetic
OPENSKY_POLL_INTERVAL_S=15
OPENSKY_BBOX=45,5,55,15

# Synthetic generator + chaos knobs (Phase 1 sweeps these).
GEN_AIRCRAFT=50
GEN_RATE_HZ=1.0
GEN_SEED=1337
CHAOS_OUT_OF_ORDER_PROB=0.0
CHAOS_MAX_SKEW_S=5.0
CHAOS_DUPLICATE_PROB=0.0
CHAOS_LATE_PROB=0.0
CHAOS_LATE_DELAY_S=90.0
CHAOS_DROP_PROB=0.0

# Windowing
WINDOW_S=60
ALLOWED_LATENESS_S=30.0

REDIS_URL=redis://redis:6379/0

# Auth. CHANGE JWT_SECRET outside local development.
JWT_SECRET=dev-only-change-me
JWT_TTL_S=3600
API_USER=operator
API_PASSWORD=contrail
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
